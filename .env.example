# Copy to .env and fill in. Every value below is read by app/core/config.py.

# ----------------------------------------------------------------- app -----
APP_NAME="Class Management Assistant"
ENVIRONMENT=local           # local | development | staging | production
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false

# IANA timezone used to decide what "today" means for attendance and reports.
TIMEZONE=Asia/Ho_Chi_Minh

# ------------------------------------------------------------ database -----
# Local dev (app on host): localhost. Docker Compose overrides this to host "db".
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/class_management
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ---------------------------------------------------------------- groq -----
# API key from https://console.groq.com/keys
GROQ_API_KEY=
# Chat model with tool calling — NOT meta-llama/llama-prompt-guard-* (classifier only).
GROQ_MODEL=llama-3.3-70b-versatile
# Optional. Official Groq SDK root URL — do NOT include /openai/v1 (the SDK adds it).
# GROQ_BASE_URL=https://api.groq.com
GROQ_TIMEOUT_SECONDS=120
GROQ_MAX_RETRIES=1
GROQ_LOG_PROMPTS=false

# ----------------------------------------------------------- assistant -----
# How long a chat keeps its context (and attendance focus) while idle.
CONVERSATION_TTL_SECONDS=1800
# Safety valve on sequential tool calls within one user turn.
MAX_TOOL_ITERATIONS=8
# Conversation history items retained per chat.
MAX_HISTORY_ITEMS=40

# ----------------------------------------------------------------- api -----
API_HOST=0.0.0.0
API_PORT=8000

# ------------------------------------------------- docker compose only -----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=class_management
# Host port mapped to Postgres in Docker. Use 5433 if local Postgres already uses 5432.
POSTGRES_PORT=5432