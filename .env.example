# Copy to .env and fill in. Every value below is read by app/core/config.py.

# ----------------------------------------------------------------- app -----
APP_NAME="Class Management Assistant"
ENVIRONMENT=local           # local | development | staging | production
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false

# IANA timezone used to decide what "today" means for attendance and reports.
TIMEZONE=Asia/Ho_Chi_Minh

# ------------------------------------------------------------ database -----
# The +asyncpg driver is added automatically if you omit it.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/class_management
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ------------------------------------------------------------ telegram -----
# From @BotFather.
TELEGRAM_BOT_TOKEN=

# polling: the bot fetches updates itself (no public URL needed).
# webhook: Telegram posts to TELEGRAM_WEBHOOK_URL.
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# Optional allow-list of Telegram user ids. Leave empty to let anyone onboard.
# Example: TELEGRAM_ALLOWED_USER_IDS=[123456789,987654321]
TELEGRAM_ALLOWED_USER_IDS=[]

# -------------------------------------------------------------- ollama -----
# Local Ollama server. Use host.docker.internal when the app runs in Docker.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_RETRIES=1

# ----------------------------------------------------------- assistant -----
# How long a chat keeps its context (and attendance focus) while idle.
CONVERSATION_TTL_SECONDS=1800
# Safety valve on sequential tool calls within one user turn.
MAX_TOOL_ITERATIONS=8
# Conversation history items retained per chat.
MAX_HISTORY_ITEMS=40

# ----------------------------------------------------------------- api -----
API_HOST=0.0.0.0
API_PORT=8000

# ------------------------------------------------- docker compose only -----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=class_management
POSTGRES_PORT=5432
